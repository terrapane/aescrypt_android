<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Basic Foreground Service Permission -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Specific permission for dataSync operations (required on API 34+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required on Android 13+ to display the status bar notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Need access to read/write files -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:requestLegacyExternalStorage="true"
        android:theme="@style/Theme.AESCrypt">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AESCrypt">

            <!-- Standard launcher filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Intent for opening .aes files -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <!-- Match both content:// and file:// URI schemes -->
                <data android:scheme="content" />
                <data android:scheme="file" />

                <!-- Match .aes extension in path -->
                <data android:host="*" />
                <data android:pathPattern=".*\.aes" />
                <data android:pathPattern=".*\..*\.aes" />
                <data android:pathPattern=".*\..*\..*\.aes" />
            </intent-filter>

            <!-- Intent for opening other file types -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <!-- Match both content:// and file:// URI schemes -->
                <data android:scheme="content" />
                <data android:scheme="file" />

                <!-- Any arbitrary MIME type from file managers -->
                <data android:mimeType="*/*" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
        </activity>

        <service
            android:name=".AESCryptForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
